# Copy to .env.chrome and .env.firefox (both gitignored). WXT loads .env.<browser>
# for the matching build target: `pnpm build:chrome` reads .env.chrome,
# `pnpm build:firefox` reads .env.firefox. One Bungie app per browser because
# Bungie allows a single redirect URL per app (see README).
WXT_BUNGIE_API_KEY=
WXT_BUNGIE_CLIENT_ID=
